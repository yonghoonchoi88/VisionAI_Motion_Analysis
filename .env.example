# ─────────────────────────────────────────────────────────────
# 사용법: cp .env.example .env  → 값 수정 (.env는 Git에 올리지 않음)
# Docker Compose 실행 시 호스트 주소(postgres·redis·fastapi)는 compose.yaml이 자동으로 바꿔 넣습니다.
# 아래 localhost 값은 Docker 없이 로컬에서 Django를 직접 실행할 때 쓰입니다.
# ─────────────────────────────────────────────────────────────

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL
POSTGRES_DB=vision_action
POSTGRES_USER=vision
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis · Celery  (CELERY_TASK_ALWAYS_EAGER=1 이면 Redis·Worker 없이 요청 안에서 바로 실행: 개발용)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=0

# AI 추론 서버 (FastAPI)
FASTAPI_URL=http://localhost:8001
FASTAPI_TIMEOUT_SECONDS=300
MAX_UPLOAD_MB=200
# Docker fastapi 컨테이너의 연산 장치 (기본 cpu)
POSE_DEVICE=cpu
# 1이면 ai_service/models/SHA256SUMS.txt로 해시를 확인한 모델만 연다 (목록 만들기: README '모델 준비')
REQUIRE_MODEL_CHECKSUM=1
# 판단 불확실 기준 덮어쓰기 (비우면 ai_service/project.json의 decision 값)
MIN_CONFIDENCE=
MIN_MARGIN=

# IP Webcam — 허용 카메라 host:port 목록(쉼표 구분). 여기에 없는 주소는 서버가 호출하지 않습니다.
ALLOWED_CAMERA_HOSTS=192.168.0.10:8080
CAMERA_CAPTURE_SECONDS=8

# 호스트(PC) 쪽 공개 포트 — 이미 사용 중이면 바꾸세요 (컨테이너끼리는 서비스 이름으로 통신하므로 영향 없음)
DJANGO_HOST_PORT=8000
FASTAPI_HOST_PORT=8001
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
